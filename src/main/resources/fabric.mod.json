{
  "schemaVersion": 1,
  "id": "customsplash",
  "version": "${version}",
  "name": "CustomSplash 自定义启动界面",
  "description": "用图片 / GIF / 视频替换 Minecraft 的早期启动屏、主菜单背景和世界加载界面。把文件丢进 config/customsplash/ 就能用。",
  "authors": [
    "Miraphael"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/customsplash/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.customsplash.CustomSplash"
    ]
  },
  "mixins": [
    "customsplash.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.1",
    "java": ">=25"
  }
}
